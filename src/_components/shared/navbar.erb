<header class="masthead">
  <div class="container">
    <a href="<%= relative_url '/' %>" class="masthead-logo" aria-label="AKASHI.rb ホームへ">
      <img src="<%= relative_url '/images/AKASHI_rb.png' %>"
           alt="AKASHI.rb"
           width="216" height="216"
           class="masthead-logo-img" />
    </a>
    <p class="masthead-tagline"><%= @metadata.tagline %></p>
  </div>
</header>

<nav class="site-nav" aria-label="サイト内ナビゲーション">
  <div class="container">
    <ul>
      <% links.each do |link| %>
        <li>
          <a href="<%= relative_url link[:path] %>" <% if current?(link[:path]) %>aria-current="page"<% end %>><%= link[:label] %></a>
        </li>
      <% end %>
    </ul>
  </div>
</nav>
