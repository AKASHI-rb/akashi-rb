---
layout: default
---

<header class="page-head">
  <div class="container">
    <h1 class="page-title"><%= data.title %></h1>
    <% if data.subtitle %>
      <p class="page-subtitle"><%= data.subtitle %></p>
    <% end %>
  </div>
</header>

<div class="page-body">
  <div class="container">
    <div class="<%= data.container_class %>">
      <%= yield %>
    </div>
  </div>
</div>
